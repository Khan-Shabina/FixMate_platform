# Spring Boot Application Settings
spring.application.name=fixmate-backend
server.port=8080

# MySQL Database Configuration
spring.datasource.url=jdbc:mysql://localhost:3306/fixmate_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true
spring.datasource.username=YOUR_DATABASE_USERNAME
spring.datasource.password=YOUR_DATABASE_PASSWORD
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# JPA & Hibernate Settings
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

# SQL Initialization
spring.jpa.defer-datasource-initialization=true
spring.sql.init.mode=never

# JWT Configuration
app.jwt.secret=YOUR_64_CHARACTER_MINIMUM_HEX_OR_BASE64_SECRET_KEY
app.jwt.expiration-ms=86400000

# CORS Settings
cors.allowed-origins=http://localhost:5173,http://localhost:3000
